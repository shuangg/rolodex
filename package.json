{
  "name": "rolodex",
  "version": "1.0.0",
  "private": true,
  "description": "A personal CRM you run on your own computer.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=5174 tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "node scripts/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset": "node -e \"import('fs').then(f=>f.rmSync('data/rolodex.db',{force:true}))\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "lucide-react": "^0.525.0",
    "multer": "^2.2.0",
    "papaparse": "^5.4.1",
    "react": "^19.1.0",
    "react-big-calendar": "^1.18.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.10.1",
    "vcf": "^2.0.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.2",
    "@types/vcf": "^2.0.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
