{
  "name": "rolodex",
  "private": true,
  "version": "1.0.0",
  "description": "A private, personal CRM you run on your own computer.",
  "type": "module",
  "scripts": {
    "start": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite --host\"",
    "dev": "npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "lucide-react": "^0.544.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-calendar": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.3",
    "vcf": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.1.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-calendar": "^4.1.0",
    "@types/vcf": "^2.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
